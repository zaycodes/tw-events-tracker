---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import EventCard from "../components/EventCard.astro";
import FilterBar from "../components/FilterBar.astro";
import { TAGS } from "../content/config";
import { groupByMonth } from "../lib/eventGrouping";

const allEvents = await getCollection("events");
const now = new Date();

// Most-recent-first throughout — the event that ended most recently leads,
// same convention aideadlin.es uses for its past-deadlines section.
const past = allEvents
  .map((e) => e.data)
  .filter((e) => (e.endDate ?? e.startDate) < now)
  .sort((a, b) => b.startDate.getTime() - a.startDate.getTime());

const byYear = new Map<number, typeof past>();
for (const event of past) {
  const year = event.startDate.getUTCFullYear();
  if (!byYear.has(year)) byYear.set(year, []);
  byYear.get(year)!.push(event);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
---

<Layout title="Past Events — TW Events">
  <header class="page-header">
    <h1 class="page-title">Past events</h1>
    <p class="muted">
      A record of what's already happened — for reference, or in case a recurring edition of one
      of these is due back on the <a href="/">upcoming list</a>. Most recent first.
    </p>
  </header>

  <FilterBar tags={TAGS} />

  <div id="event-list">
    {years.map((year) => (
      <section class="year-group" data-year={year} id={`year-${year}`}>
        <h2 class="year-heading">{year}</h2>
        {groupByMonth(byYear.get(year)!, "desc").map((mg) => (
          <div class="month-group">
            <h3 class="month-heading">{mg.label}</h3>
            <div class="event-stack">
              {mg.events.map((event) => <EventCard event={event} pastMode />)}
            </div>
          </div>
        ))}
      </section>
    ))}
  </div>

  <p id="empty-state" class="muted" style="display: none;">
    No past events match those filters.
  </p>

  {past.length === 0 && <p class="muted">Nothing here yet — check back once events start wrapping up.</p>}
</Layout>

<style>
  .page-header {
    padding: 1.75rem 0 0.5rem;
    margin-bottom: 0.5rem;
  }
  .page-title {
    margin: 0 0 0.5rem;
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .year-group {
    margin-top: 2rem;
    scroll-margin-top: 1rem;
  }
  .year-group:first-of-type {
    margin-top: 0.5rem;
  }
  .year-heading {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--text-muted);
    margin: 0 0 1rem;
    padding-bottom: 0.4rem;
    border-bottom: 2px solid var(--border);
  }
  .month-group {
    margin-top: 1.25rem;
  }
  .month-group:first-of-type {
    margin-top: 0;
  }
  .month-heading {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0 0 0.6rem;
  }
  .event-stack {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
</style>
