---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import EventCard from "../components/EventCard.astro";
import FilterBar from "../components/FilterBar.astro";
import { TAGS } from "../content/config";
import { groupByMonth } from "../lib/eventGrouping";

const allEvents = await getCollection("events");
const now = new Date();

const upcoming = allEvents
  .map((e) => e.data)
  .filter((e) => (e.endDate ?? e.startDate) >= now)
  .sort((a, b) => {
    const deadlineA = new Date(a.cfpDeadline ?? a.registrationDeadline ?? a.startDate);
    const deadlineB = new Date(b.cfpDeadline ?? b.registrationDeadline ?? b.startDate);
    return deadlineA.getTime() - deadlineB.getTime();
  });

// Grouped by the year the event itself falls in (not the deadline's year),
// so "2027" only ever means "the event happens in 2027" — unambiguous even
// once an event has a 2026 CFP deadline for a 2027 edition. Order within
// each year still follows the deadline-soonest sort above, and each year is
// further split into month sub-groups (see groupByMonth).
const byYear = new Map<number, typeof upcoming>();
for (const event of upcoming) {
  const year = event.startDate.getUTCFullYear();
  if (!byYear.has(year)) byYear.set(year, []);
  byYear.get(year)!.push(event);
}
const years = [...byYear.keys()].sort((a, b) => a - b);
---

<Layout title="Technical Writing & No-Code Events Tracker">
  <section class="hero">
    <div class="hero-shapes" aria-hidden="true">
      <span class="shape shape--blob-coral"></span>
      <span class="shape shape--blob-teal"></span>
      <span class="shape shape--blob-gold"></span>
      <span class="shape shape--blob-purple"></span>
      <span class="shape shape--sparkle shape--sparkle-1">✦</span>
      <span class="shape shape--sparkle shape--sparkle-2">✦</span>
      <span class="shape shape--dot shape--dot-1"></span>
      <span class="shape shape--dot shape--dot-2"></span>
    </div>
    <div class="hero-content">
      <p class="hero-eyebrow">✨ Refreshed weekly</p>
      <h1 class="hero-title">Upcoming events</h1>
      <p class="hero-sub">
        Conferences, community meetups, webinars, and no-code events for technical writers —
        open to community submissions.
      </p>
      <p class="hero-stat">
        Tracking <strong>{upcoming.length}</strong> upcoming event{upcoming.length === 1 ? "" : "s"}
        across <strong>{years.length}</strong> year{years.length === 1 ? "" : "s"}
      </p>
    </div>
  </section>

  <FilterBar tags={TAGS} showSort />

  <div id="event-list">
    {years.map((year) => (
      <section class="year-group" data-year={year} id={`year-${year}`}>
        <h2 class="year-heading">{year}</h2>
        {groupByMonth(byYear.get(year)!).map((mg) => (
          <div class="month-group">
            <h3 class="month-heading">{mg.label}</h3>
            <div class="event-stack">
              {mg.events.map((event) => <EventCard event={event} />)}
            </div>
          </div>
        ))}
      </section>
    ))}
  </div>

  {/* Flat list, already sorted deadline-soonest-first (same `upcoming` order
      as above, just not bucketed by year/month) — toggled into view by the
      "Sort" control in FilterBar. Rendered at build time either way, so
      switching is a plain visibility swap with no client-side re-sorting. */}
  <div id="deadline-view" class="event-stack" style="display: none;">
    {upcoming.map((event) => <EventCard event={event} />)}
  </div>

  <p id="empty-state" class="muted" style="display: none;">
    No events match those filters. <a href="/submit">Know one we're missing?</a>
  </p>

  {upcoming.length === 0 && (
    <p class="muted">No upcoming events yet — check back soon, or <a href="/submit">add one</a>.</p>
  )}
</Layout>

<style>
  /* Full-bleed: break out of .wrap's centered max-width so the gradient
     spans the whole viewport, while .hero-content below stays aligned to
     the same max-width as the rest of the page. */
  .hero {
    position: relative;
    overflow: hidden;
    width: auto;
    margin-left: calc(-50vw + 50%);
    margin-right: calc(-50vw + 50%);
    margin-top: -1px;
    margin-bottom: 2.5rem;
    padding: 3.5rem 0;
    background: linear-gradient(135deg, #7c3aed 0%, #6d28d9 45%, #4c1d95 100%);
    isolation: isolate;
  }
  :root[data-theme="dark"] .hero {
    background: linear-gradient(135deg, #5b21b6 0%, #4c1d95 45%, #2e1065 100%);
  }

  .hero-shapes {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }
  .shape {
    position: absolute;
    border-radius: 50%;
  }
  .shape--blob-coral,
  .shape--blob-teal,
  .shape--blob-gold,
  .shape--blob-purple {
    filter: blur(60px);
    opacity: 0.5;
  }
  .shape--blob-coral {
    width: 260px;
    height: 260px;
    top: -90px;
    right: 12%;
    background: #fb7185;
  }
  .shape--blob-teal {
    width: 220px;
    height: 220px;
    bottom: -80px;
    left: 8%;
    background: #2dd4bf;
    opacity: 0.4;
  }
  .shape--blob-gold {
    width: 160px;
    height: 160px;
    top: 25%;
    right: 32%;
    background: #fbbf24;
    opacity: 0.3;
  }
  .shape--blob-purple {
    width: 200px;
    height: 200px;
    bottom: -60px;
    right: -40px;
    background: #c4b5fd;
    opacity: 0.35;
  }
  .shape--dot {
    width: 14px;
    height: 14px;
    background: #fbbf24;
    opacity: 0.7;
  }
  .shape--dot-1 {
    top: 24%;
    left: 5%;
  }
  .shape--dot-2 {
    bottom: 20%;
    left: 46%;
    width: 9px;
    height: 9px;
    background: #2dd4bf;
    opacity: 0.6;
  }
  .shape--sparkle {
    color: rgba(255, 255, 255, 0.55);
    font-size: 1.4rem;
  }
  .shape--sparkle-1 {
    top: 20%;
    left: 38%;
  }
  .shape--sparkle-2 {
    bottom: 22%;
    left: 22%;
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.4);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .hero-eyebrow {
    display: inline-block;
    margin: 0 0 0.75rem;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .hero-title {
    margin: 0 0 0.6rem;
    font-size: clamp(2rem, 5vw, 2.9rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.05;
    color: #fff;
  }
  .hero-sub {
    max-width: 46rem;
    margin: 0 0 1.1rem;
    color: rgba(255, 255, 255, 0.85);
    font-size: 1.02rem;
  }
  .hero-stat {
    margin: 0;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.75);
  }
  .hero-stat strong {
    color: #fff;
    font-family: var(--font-display);
  }

  .year-group {
    margin-top: 2rem;
    scroll-margin-top: 1rem;
  }
  .year-group:first-of-type {
    margin-top: 0.5rem;
  }
  .year-heading {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--text-muted);
    margin: 0 0 1rem;
    padding-bottom: 0.4rem;
    border-bottom: 2px solid var(--border);
  }
  .month-group {
    margin-top: 1.25rem;
  }
  .month-group:first-of-type {
    margin-top: 0;
  }
  .month-heading {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0 0 0.6rem;
  }
  .event-stack {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
</style>
