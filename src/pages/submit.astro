---
import Layout from "../layouts/Layout.astro";
import { TAGS } from "../content/config";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Submit an event — TW Events">
  <h1>Submit an event</h1>
  <p class="muted">
    Know a conference, meetup, webinar, CFP, or mentorship program we're missing?
    Fill this in and it'll land in our review queue as a GitHub issue — prefer GitHub?
    <a href="https://github.com/zaycodes/tw-events-tracker/issues/new?template=submit-event.yml" target="_blank" rel="noopener">Use the issue form instead</a>.
  </p>

  {error === "missing_fields" && (
    <p class="error">Please fill in the required fields (name, link, organizer, format, start date).</p>
  )}
  {error === "1" && (
    <p class="error">Something went wrong submitting that. Please try again in a bit.</p>
  )}

  <form method="POST" action="/api/submit-event" class="event-form">
    <p class="hidden-field">
      <label>Don't fill this in if you're human: <input name="bot-field" /></label>
    </p>

    <label>
      Event name *
      <input type="text" name="name" required />
    </label>

    <label>
      Link *
      <input type="url" name="url" required placeholder="https://" />
    </label>

    <label>
      Organizer *
      <input type="text" name="organizer" required />
    </label>

    <div class="row">
      <label>
        Format *
        <select name="format" required>
          <option value="">Select…</option>
          <option value="virtual">Virtual</option>
          <option value="in-person">In-person</option>
          <option value="hybrid">Hybrid</option>
        </select>
      </label>

      <label>
        Cost
        <select name="cost">
          <option value="unknown">Unknown</option>
          <option value="free">Free</option>
          <option value="paid">Paid</option>
        </select>
      </label>
    </div>

    <label>
      Location <span class="muted">(if in-person or hybrid)</span>
      <input type="text" name="location" />
    </label>

    <div class="row">
      <label>
        Start date *
        <input type="date" name="startDate" required />
      </label>
      <label>
        End date
        <input type="date" name="endDate" />
      </label>
    </div>

    <div class="row">
      <label>
        CFP / call for speakers deadline
        <input type="date" name="cfpDeadline" />
      </label>
      <label>
        Registration deadline
        <input type="date" name="registrationDeadline" />
      </label>
    </div>

    <label>
      Tags <span class="muted">(comma-separated — {TAGS.join(", ")})</span>
      <input type="text" name="tags" placeholder="technical-writing, no-code" />
    </label>

    <label>
      Description
      <textarea name="description" rows="3"></textarea>
    </label>

    <label>
      Your contact <span class="muted">(optional — in case we have questions)</span>
      <input type="text" name="submitterContact" />
    </label>

    <button type="submit">Submit for review</button>
  </form>
</Layout>

<style>
  .event-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 520px;
    margin-top: 1.5rem;
  }
  .event-form label {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    font-size: 0.9rem;
  }
  .event-form input,
  .event-form select,
  .event-form textarea {
    padding: 0.5rem 0.65rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: var(--bg);
    color: var(--text);
  }
  .row {
    display: flex;
    gap: 1rem;
  }
  .row > label {
    flex: 1;
  }
  .hidden-field {
    position: absolute;
    left: -9999px;
  }
  button {
    align-self: flex-start;
    padding: 0.6rem 1.2rem;
    border: none;
    border-radius: 0.5rem;
    background: var(--accent);
    color: var(--accent-contrast);
    font-weight: 600;
    cursor: pointer;
  }
  .error {
    background: #fee2e2;
    color: #991b1b;
    padding: 0.6rem 0.9rem;
    border-radius: 0.5rem;
  }
</style>
