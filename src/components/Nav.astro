---
import { getCollection } from "astro:content";
import ThemeToggle from "./ThemeToggle.astro";

// Computed independently of whatever page renders the Nav, so the year
// quick-links work the same from any route — always jump to that year's
// section on the upcoming-events page.
const allEvents = await getCollection("events");
const now = new Date();
const upcomingYears = [
  ...new Set(
    allEvents
      .map((e) => e.data)
      .filter((e) => (e.endDate ?? e.startDate) >= now)
      .map((e) => e.startDate.getUTCFullYear())
  ),
].sort((a, b) => a - b);
---

<header class="nav wrap">
  <a class="logo" href="/" aria-label="Zaycodes — home">
    <img src="/images/zaycodes-wordmark-light.png" alt="zaycodes" class="logo-wordmark logo-wordmark--light" height="30" />
    <img src="/images/zaycodes-wordmark.png" alt="zaycodes" class="logo-wordmark logo-wordmark--dark" height="30" />
  </a>
  <span class="brand-sep">/</span>
  <a class="brand-suffix" href="/">TW Events</a>
  <nav>
    <a href="/">Upcoming</a>
    {upcomingYears.map((year) => (
      <a href={`/#year-${year}`} class="year-link">{year}</a>
    ))}
    <a href="/past">Past</a>
    <a href="/submit">Submit an event</a>
    <a href="https://github.com/zaycodes/tw-events-tracker" target="_blank" rel="noopener">GitHub</a>
    <ThemeToggle />
  </nav>
</header>

<style>
  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    row-gap: 0.6rem;
    padding: 1.25rem;
    border-bottom: 1px solid var(--border);
  }
  .logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }
  .logo-wordmark {
    height: 30px;
    width: auto;
    display: block;
  }
  /* Two real logo assets (from zaycodes.com itself) — purple wordmark for
     light backgrounds, off-white wordmark for dark. No image gets
     recolored or boxed in a chip; the right one is just shown per theme. */
  .logo-wordmark--dark {
    display: none;
  }
  :global(html[data-theme="dark"]) .logo-wordmark--light {
    display: none;
  }
  :global(html[data-theme="dark"]) .logo-wordmark--dark {
    display: block;
  }
  .logo:hover .logo-wordmark {
    opacity: 0.85;
  }
  .brand-sep {
    color: var(--border);
    margin: 0 0.6rem;
  }
  .brand-suffix {
    font-weight: 700;
    text-decoration: none;
    color: var(--text);
    margin-right: auto;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1.1rem;
    margin-left: 1.5rem;
  }
  nav a {
    text-decoration: none;
    color: var(--text-muted);
    font-size: 0.9rem;
    white-space: nowrap;
  }
  nav a:hover {
    color: var(--accent);
  }
  .year-link {
    font-size: 0.78rem;
    font-weight: 600;
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 999px;
  }

  /* Below ~640px the single-row layout doesn't have room for logo + brand
     text + six-plus nav items — give the nav its own full-width row instead
     of letting things get clipped at the container edge. */
  @media (max-width: 640px) {
    .nav {
      padding: 1rem;
    }
    .brand-suffix {
      margin-right: 0;
    }
    nav {
      width: 100%;
      margin-left: 0;
      gap: 0.5rem 0.85rem;
    }
    nav a {
      font-size: 0.85rem;
    }
  }
</style>
